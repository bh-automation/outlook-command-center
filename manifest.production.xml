<?xml version="1.0" encoding="UTF-8"?>
<!-- Benedict Precision Workspace – Outlook-Add-in (nur Manifest, ohne Laufzeitlogik).
     Einzige Berechtigung: ReadWriteItem (Kategorien der geöffneten Nachricht setzen/entfernen). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>679d2f32-8bb2-4054-868b-bda612d4c1eb</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Benedict Havertz</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Precision Workspace"/>
  <Description DefaultValue="Status-Kategorien (ACTION, WAITING, PROJECT, DONE, REFERENCE) für die geöffnete Nachricht. Lokal, ohne Tracking."/>
  <IconUrl DefaultValue="https://bh-automation.github.io/outlook-command-center/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://bh-automation.github.io/outlook-command-center/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://bh-automation.github.io/outlook-command-center/support.html"/>
  <AppDomains>
    <AppDomain>https://bh-automation.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://bh-automation.github.io/outlook-command-center/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!-- v1.1 wird für SupportsPinning benötigt (ItemChanged-Ereignis bei Nachrichtenwechsel). -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="pwReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="pwOpenPaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://bh-automation.github.io/outlook-command-center/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://bh-automation.github.io/outlook-command-center/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://bh-automation.github.io/outlook-command-center/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://bh-automation.github.io/outlook-command-center/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://bh-automation.github.io/outlook-command-center/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Precision"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Precision Workspace"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Öffnet den Precision Workspace: Status der Nachricht setzen (nur Kategorien)."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
